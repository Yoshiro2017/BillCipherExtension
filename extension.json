{
	"name": "BillCipherExtension",
	"author": [
		"The All Seeing Eye"
	],
	"url": "https://miraheze.org",
	"descriptionmsg": "billcipher-desc",
	"license-name": "MIT",
	"type": "other",
	"requires": {
		"MediaWiki": ">= 1.45.0"
	},
	"AutoloadNamespaces": {
		"MediaWiki\\Extension\\BillCipherExtension\\": "src/"
	},
	"config": {
		"BillCipherEnableDealBox": {
			"description": "Enables the dimensional deal-making feature.",
			"value": true
		},
		"BillCipherVandalizeReality": {
			"description": "Allows Bill Cipher to alter background colors upon a handshake.",
			"value": true
		}
	},
	"HookHandlers": {
		"BillCipherHooks": {
			"class": "MediaWiki\\Extension\\BillCipherExtension\\Hooks"
		}
	},
	"Hooks": {
		"ParserFirstCallInit": "BillCipherHooks",
		"BeforePageDisplay": "BillCipherHooks"
	},
	"MessagesDirs": {
		"BillCipherExtension": [
			"i18n"
		]
	},
	"ResourceModules": {
		"ext.billcipher": {
			"localBasePath": "resources",
			"remoteExtPath": "BillCipherExtension/resources",
			"dependencies": [],
			"styles": [
				"ext.billcipher.css"
			],
			"packageFiles": [
				"ext.billcipher.js"
			],
			"messages": []
		}
	},
	"manifest_version": 2
}
